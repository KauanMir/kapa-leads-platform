# ------------------------------------------------------------------
# KAPA Leads Platform — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione o .env.local (ele já está no .gitignore).
# ------------------------------------------------------------------

# URL do projeto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=

# Chave PUBLICÁVEL do Supabase (sb_publishable_...).
# Pode ser pública: o acesso aos dados é controlado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA do Supabase (sb_secret_...).
# SOMENTE servidor. Ignora o RLS.
# JAMAIS usar com prefixo NEXT_PUBLIC_ e jamais importar em código do navegador.
SUPABASE_SECRET_KEY=

# Libera `npm run test:rls`, que CRIA e REMOVE dados reais no Supabase
# configurado acima. Use "true" somente em projeto de desenvolvimento.
# Prefira definir só na sessão do terminal, na hora de rodar.
ALLOW_REMOTE_RLS_TESTS=false
