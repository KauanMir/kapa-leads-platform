# ------------------------------------------------------------------
# KAPA Leads Platform — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione o .env.local (ele já está no .gitignore).
#
# Produção: as 3 variáveis do Supabase são obrigatórias — o `next build` falha
# sem elas (ou com URL não-https, ou com segredo em NEXT_PUBLIC_*).
# Checklist completo: docs/deploy-producao.md
# ------------------------------------------------------------------

# URL do projeto Supabase (pública).
NEXT_PUBLIC_SUPABASE_URL=

# Chave PUBLICÁVEL do Supabase (sb_publishable_...).
# Pode ser pública: o acesso aos dados é controlado pelo RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave SECRETA do Supabase (sb_secret_...).
# SOMENTE servidor. Ignora o RLS.
# JAMAIS usar com prefixo NEXT_PUBLIC_ e jamais importar em código do navegador.
SUPABASE_SECRET_KEY=

# Origens extras aceitas pela API pública FORA de produção, separadas por
# vírgula (ex.: http://localhost:3001 para a LP Duelo). Ignorada quando NODE_ENV=production
# (não definir no deploy).
# Ver docs/integracao-landing-page.md.
PUBLIC_LEADS_DEV_ORIGINS=

# Rate limit da API pública, por IP, EM MEMÓRIA (por instância do servidor).
# Vazio = padrão (30 envios a cada 60 s). Inválido = padrão + aviso no log.
# É só a primeira camada: em produção, migrar para Cloudflare WAF/Turnstile ou
# limiter distribuído (docs/integracao-landing-page.md, seção 9).
PUBLIC_LEADS_RATE_LIMIT_MAX=
PUBLIC_LEADS_RATE_LIMIT_WINDOW_SECONDS=

# Liberam os testes remotos, que CRIAM e REMOVEM dados reais no Supabase
# configurado acima: `npm run test:rls` e `npm run test:api`.
# Use "true" somente em projeto de desenvolvimento.
# Prefira definir só na sessão do terminal, na hora de rodar.
ALLOW_REMOTE_RLS_TESTS=false
ALLOW_REMOTE_API_TESTS=false
ALLOW_REMOTE_ADMIN_TESTS=false
# test:e2e também precisa do servidor rodando (npm run build && npx next start -p 3123).
ALLOW_REMOTE_E2E_TESTS=false
E2E_BASE_URL=http://localhost:3123
