{
  "name": "kapa-leads-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "test": "vitest run --project unit",
    "test:rls": "vitest run --project rls",
    "test:api": "vitest run --project api",
    "test:admin": "vitest run --project admin",
    "test:e2e": "vitest run --project e2e",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "dev:setup": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-setup.mjs",
    "db:compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-compare.mjs",
    "prod:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-production.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.54.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
